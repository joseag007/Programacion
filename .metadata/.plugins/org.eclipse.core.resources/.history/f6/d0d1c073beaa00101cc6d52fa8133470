package ejercicio5;

import java.util.Scanner;

public class Ejercicio5 {

	public static void main(String[] args) {

		Scanner teclado = new Scanner(System.in);
		
		
		System.out.println("Introduzca un valor: ");
        int num = teclado.nextInt();
        
        int mediaPositiva=0;
        int cero=0;
        int contadorPositivo=1;
        int contadorNegativo=1;
        int mediaNegativa=0;
        int contador;
		
		 do {
		     
		     if (num>=0) {
		    	 
		    	 mediaPositiva= mediaPositiva+num;
				 contadorPositivo++;
				 System.out.println("Introduzca un valor: ");
			     num = teclado.nextInt();
		    	 
		     }else {
		    	 mediaNegativa= mediaNegativa+num;
				 contadorNegativo++;
				 System.out.println("Introduzca un valor: ");
			     num = teclado.nextInt();
		     }
		     
		     if ( num == 0) {
		    	 cero++;
		     }
		    contador = contadorPositivo + contadorNegativo;
	        } while ( contador <= 10 && num >= 0);
		 
		 System.out.println("La media de los números positivos introducidos es: " + mediaPositiva/contador);
		 System.out.println("La media de los números negativos introducidos es: " + mediaNegativa/contador);
		 System.out.println("El total de ceros introducidos es de: " + cero);
		 
		}
		
	}


