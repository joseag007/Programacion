package ejercicio5;

import java.util.Scanner;

public class Ejercicio5 {

    public static void main(String[] args) {

        Scanner teclado = new Scanner(System.in);

        int sumaPositivos = 0;
        int contadorPositivos = 0;
        int sumaNegativos = 0;
        int contadorNegativos = 0;
        int contadorCeros = 0;

        int contadorTotal = 0;

        do {
            System.out.print("Introduce un número: ");
            int num = teclado.nextInt();

            if (num > 0) {
                sumaPositivos += num;
                contadorPositivos++;
            } else if (num < 0) {
                sumaNegativos += num;
                contadorNegativos++;
            } else {
                contadorCeros++;
            }

            contadorTotal++;

        } while (contadorTotal < 10);

            System.out.println("Media de los positivos: " + (double) sumaPositivos / contadorPositivos);
        
            System.out.println("Media de los negativos: " + (double) sumaNegativos / contadorNegativos);
        
        System.out.println("Cantidad de ceros introducidos: " + contadorCeros);
    }
}